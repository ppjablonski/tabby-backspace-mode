{
  "name": "tabby-backspace-mode",
  "version": "0.1.5",
  "description": "Adds the \"Backspace key mode\" option to local (non-SSH) profiles in Tabby.",
  "license": "MIT",
  "author": "tabby-backspace-mode contributors",
  "keywords": [
    "tabby-plugin",
    "tabby",
    "terminal",
    "backspace",
    "wsl"
  ],
  "main": "dist/index.js",
  "files": [
    "dist/index.js"
  ],
  "scripts": {
    "test": "npm run build && tsx --test test/*.test.ts",
    "typecheck": "tsc --noEmit",
    "build": "npm run typecheck && webpack --mode production",
    "package": "npm run build && python3 scripts/package.py && npm pack --quiet --pack-destination release"
  },
  "devDependencies": {
    "@angular/common": "15.2.10",
    "@angular/compiler": "^15.2.10",
    "@angular/core": "15.2.10",
    "@angular/forms": "15.2.10",
    "@ng-bootstrap/ng-bootstrap": "14.2.0",
    "@types/node": "18.19.130",
    "rxjs": "7.8.2",
    "tabby-core": "1.0.231-nightly.0",
    "tabby-local": "1.0.231-nightly.0",
    "tabby-settings": "1.0.231-nightly.0",
    "tabby-terminal": "1.0.231-nightly.0",
    "ts-loader": "9.5.4",
    "tsx": "4.20.6",
    "typescript": "4.9.5",
    "webpack": "5.112.2",
    "webpack-cli": "5.1.4"
  }
}
